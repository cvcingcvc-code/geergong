# Gorgon V1 frontend environment template.
#
# Copy to `.env` / `.env.local` (both git-ignored) and adjust.
# Only variables prefixed VITE_ are exposed to the browser bundle — and even
# then they are PUBLIC by definition. NEVER put any API key / secret here;
# provider keys (SEARCH_API_KEY etc.) belong to the Python server only.

# Base URL of the retrieval API (pipeline/api/server.py).
#
# Leave EMPTY for local development: the Vite dev/preview server proxies
# /api -> http://127.0.0.1:8000, and the browser stays same-origin (the API
# server intentionally sends no CORS headers).
#
# Set an absolute URL only when the frontend and the API live on different
# origins — e.g. a future Tauri desktop build talking to the production
# HTTPS server. That server must then explicitly allow the app's origin.
VITE_API_BASE_URL=
